# ── Copy this file to .env and fill in your values ──────────────────────────
# Never commit .env to git.
#
# Quick start:
#   1. Copy this file:  copy .env.example .env
#   2. Fill in the values below
#   3. Run: .\start-with-tunnel.ps1
# ────────────────────────────────────────────────────────────────────────────

# Database password — use a strong random string
# Generate one: openssl rand -base64 24
DB_PASSWORD=change_me_strong_password

# JWT signing secret — must be at least 32 hex characters
# Generate one: openssl rand -hex 32
JWT_SECRET=change_me_64_char_hex_string

# ── Cloudflare Tunnel / Public URL ──────────────────────────────────────────
# This is the public HTTPS URL Cloudflare gives you for your tunnel.
# It must match exactly what visitors use to reach the app (no trailing slash).
#
# Named tunnel on trycloudflare.com (free, permanent):
#   ALLOWED_ORIGIN=https://medai-yourname.trycloudflare.com
#
# Your own domain (best):
#   ALLOWED_ORIGIN=https://medai.yourdomain.com
#
# Local only (no tunnel):
#   ALLOWED_ORIGIN=http://localhost:8090
ALLOWED_ORIGIN=https://YOUR_TUNNEL_DOMAIN_HERE

# Ollama model to use for all chatbots and guidance
# llama3.2:3b = 2GB, no thinking, good quality — default for all setups
OLLAMA_MODEL_CHAT=llama3.2:3b
