# ── Copy this file to .env and fill in your values ──────────────────────────
# Never commit .env to git.

# Database password — use a strong random string
# Generate one: openssl rand -base64 24
DB_PASSWORD=change_me_strong_password

# JWT signing secret — must be at least 32 hex characters
# Generate one: openssl rand -hex 32
JWT_SECRET=change_me_64_char_hex_string

# Your public domain or server IP (used for CORS)
# Example with domain:  https://medai.yourdomain.com
# Example with IP only: http://1.2.3.4:8080
ALLOWED_ORIGIN=http://YOUR_SERVER_IP:8080

# Ollama model to use for all chatbots and guidance
# On Oracle Cloud ARM (no GPU) use a small model: llama3.2:3b
# On your local A100 machine you can keep: qwen3-coder
OLLAMA_MODEL_CHAT=llama3.2:3b
